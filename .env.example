# Copy to .env.local and adjust.

# Backend API base URL (same backend as rmd-cms v1)
# Local backend: http://localhost:9913 — production: https://api-prod.ritramd.id
VITE_API_BASE=http://localhost:9913

# Public URL of uploaded files (product photos are stored as relative paths)
VITE_STORAGE_BASE=https://cms.ritramd.id/storage/
